# OPCIONAL: o projeto roda sem .env (todo valor abaixo já é o padrão do docker-compose.yml).
# Para mudar algo:  cp .env.example .env  e edite.
# Valores só para o ambiente local de demonstração. Não use em produção.
POSTGRES_DB=ej_quest
POSTGRES_USER=ej_quest
POSTGRES_PASSWORD=ej-quest-local
# Troque se a porta já estiver ocupada na sua máquina
PORTA_POSTGRES=5433
PORTA_REDIS=6380
PORTA_API=3000
# Segredo que assina os tokens de login
TOKEN_SEGREDO=troque-este-segredo-local
# 1 = aceita também o cabeçalho X-Usuario-Id (modo demonstração, usado pelos scripts de teste)
PERMITIR_CABECALHO_USUARIO=1
